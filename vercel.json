{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/lobby/:path*",
      "destination": "/api/social?route=lobby/:path*"
    },
    {
      "source": "/api/friends/:path*",
      "destination": "/api/social?route=friends/:path*"
    },
    {
      "source": "/api/rooms/:path*",
      "destination": "/api/social?route=rooms/:path*"
    }
  ]
}
